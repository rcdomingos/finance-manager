generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  // Relações (Um usuário tem várias...)
  bankAccounts  BankAccount[]
  creditCards   CreditCard[]
  categories    Category[]
  transactions  Transaction[]
  subCategories SubCategory[]
}

model BankAccount {
  id             String   @id @default(uuid())
  bankName       String
  initialBalance Float    @default(0)
  currentBalance Float    @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Vínculo com Usuário
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]
}

model CreditCard {
  id          String   @id @default(uuid())
  title       String
  brand       String // Visa, Master, etc.
  issuer      String   @default("Outros") // Nubank, Rico, Itau, Mercado Pago, Outros
  limit       Float
  dueDate     Int      @default(10) // Dia do Vencimento (1-31)
  closingDate Int      @default(3) // Dia do Fechamento (1-31)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]
}

model Category {
  id        String   @id @default(uuid())
  name      String
  type      String // 'INCOME' | 'EXPENSE' | 'TRANSFER'
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subCategories SubCategory[]

  transactions Transaction[]
}

model SubCategory {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(uuid())
  description String?
  amount      Float
  date        DateTime
  type        String // INCOME, EXPENSE, TRANSFER

  paymentMethod String // BANK_ACCOUNT, CREDIT_CARD

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])

  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])

  creditCardId String?
  creditCard   CreditCard? @relation(fields: [creditCardId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
